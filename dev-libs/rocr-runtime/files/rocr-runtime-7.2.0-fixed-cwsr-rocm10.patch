--- a/runtime/hsa-runtime/core/runtime/amd_loader_context.cpp
+++ b/runtime/hsa-runtime/core/runtime/amd_loader_context.cpp
@@ -311,7 +311,9 @@
   assert(0 == ((uintptr_t)ptr_) % align);
   if (HSA_STATUS_SUCCESS !=
       core::Runtime::runtime_singleton_->AllocateMemory(
-          RegionMemory::System(false), size, core::MemoryRegion::AllocateNoFlags, &host_ptr_)) {
+          // Runtime-owned code-object staging must also stay resident while
+          // a new kernel module is being loaded.
+          RegionMemory::System(false), size, core::MemoryRegion::AllocateNonPaged, &host_ptr_)) {
     HSA::hsa_memory_free(ptr_);
     ptr_ = nullptr;
     host_ptr_ = nullptr;
--- a/runtime/hsa-runtime/core/runtime/amd_memory_region.cpp
+++ b/runtime/hsa-runtime/core/runtime/amd_memory_region.cpp
@@ -107,6 +107,12 @@
     mem_flag_.ui32.HostAccess = 1;
     mem_flag_.ui32.CachePolicy = HSA_CACHING_CACHED;
 
+    // HIP can obtain its kernel-argument and copy arenas from the coarse
+    // pool, bypassing ROCr's dedicated kernarg pool. Keep these runtime
+    // buffers resident too. Ordinary fine-grained allocations retain their
+    // existing policy; disabling USERPTR globally changes their performance.
+    if (kernarg || !fine_grain) mem_flag_.ui32.NonPaged = 1;
+
     if (kernarg) mem_flag_.ui32.Uncached = 1;
 
     virtual_size_ =
@@ -589,6 +595,9 @@
     return HSA_STATUS_SUCCESS;
   }
   HsaMemFlags local_mem_flag = mem_flag_;
+  // The resident policy above applies to ROCr's own allocations. Registered
+  // memory belongs to the caller, and libhsakmt rejects NonPaged for it.
+  local_mem_flag.ui32.NonPaged = 0;
   if (flags & HSA_AMD_MEMORY_POOL_UNCACHED_FLAG) {
     local_mem_flag.ui32.Uncached = 1;
     local_mem_flag.ui32.CoarseGrain = 0;
